[Unit]
Description=InvestFund transactional email outbox worker
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
User=deno
Group=deno
WorkingDirectory=/home/deno/web/ndumb.hs.vc/public_html
EnvironmentFile=/home/deno/web/ndumb.hs.vc/public_html/.env
ExecStart=/home/deno/.bun/bin/bun run email:run
TimeoutStartSec=450

[Install]
WantedBy=multi-user.target
