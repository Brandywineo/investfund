DATABASE_URL=postgresql://investfund:change-me@127.0.0.1:5432/investfund
DATABASE_POOL_SIZE=10
DATABASE_SSL=disable
APP_ORIGIN=http://localhost:3000
SESSION_SECRET=replace-with-at-least-32-random-characters
EMAIL_SETTINGS_ENCRYPTION_KEY=replace-with-32-byte-base64url-value
HOST=127.0.0.1
PORT=9002
BSC_RPC_URL=https://your-bsc-rpc.example
BSC_RPC_URLS=https://your-primary-bsc-rpc.example,https://your-fallback-bsc-rpc.example
BSC_RPC_COOLDOWN_MS=15000
BSC_RPC_TIMEOUT_MS=10000
BSC_RPC_TARGET_CU_PER_SECOND=180
BSC_RPC_BURST_SECONDS=2
BSC_START_BLOCK=0
BSC_SCAN_BLOCKS=500
BSC_LOG_CHUNK_BLOCKS=10
BSC_RPC_CONCURRENCY=4
BSC_ADDRESS_BATCH_SIZE=25
BSC_MAINTENANCE_INTERVAL_MS=60000
BSC_CATCHUP_MAX_BATCHES=10
BSC_CATCHUP_MAX_RUNTIME_MS=55000
MIN_HOT_GAS_BNB=0.00002
BNB_DUST_RECOVERY_MIN=0.000001
BNB_DUST_RECOVERY_FEE_ESTIMATE=0.000001

# Optional administrator-only WhatsApp Cloud API alerts.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_API_VERSION=v23.0
WHATSAPP_TEMPLATE_NAME=investfund_hot_wallet_deposit
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_REQUEST_TIMEOUT_MS=10000
SIGNER_URL=http://127.0.0.1:9012
SIGNER_API_TOKEN=replace-with-a-long-random-secret
HD_WALLET_FILE=/secure/path/hd-wallet.json
HD_WALLET_PASSWORD=replace-with-a-separate-long-password
# Optional multi-wallet registry. When set, it replaces HD_WALLET_FILE for the signer.
HD_WALLET_REGISTRY_FILE=/secure/path/hd-wallet-registry.json
# Additional password variables are referenced by name from the registry file.
HD_WALLET_PASSWORD_RESERVE=replace-with-another-long-password
SIGNER_HOST=127.0.0.1
SIGNER_PORT=9012
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
MT5_BRIDGE_URL=http://127.0.0.1:9020
MT5_BRIDGE_TOKEN=replace-with-a-separate-long-random-secret
MT5_BRIDGE_TIMEOUT_MS=10000
MT5_HISTORY_OVERLAP_MS=604800000
